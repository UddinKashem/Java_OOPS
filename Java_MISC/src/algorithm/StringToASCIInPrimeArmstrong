    //Method: Duplicate Character count from string:
    public static void charFreqCount(String str){
        char[] cArr = str.toCharArray();
        
        HashMap<Character, Integer> charMap = new HashMap<>();
        
        for(char ch : cArr){
            charMap.put(ch, charMap.getOrDefault(ch, 0)+1);
        }
        System.out.println("Character Map: "+charMap);
        
        List<Character> cList = new ArrayList<>();
        int count = 0;
        
        for(Map.Entry<Character,Integer> entry : charMap.entrySet()){
            if(entry.getValue()>2){
                System.out.printf("[%s] occurs: [%d] times%n",entry.getKey(),entry.getValue());
            }
            if(entry.getValue() > count){
                cList.clear();
                cList.add(entry.getKey());
                count = entry.getValue();
            }
            else if(entry.getValue() == count){
                cList.add(entry.getKey());
            }
        }
        System.out.println("Max count of Char: "+count);
        System.out.println("Max occur char: "+ cList);
        
    }
    

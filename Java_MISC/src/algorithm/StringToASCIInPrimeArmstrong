    //Mehtod: Prime Check
    public static boolean primeCheck(int n){
        boolean b = true;
        
        if(n<=1){
            b=false;
        }
        
        for(int i = 2; i<= n/2; i++){
            if(n%i==0){
                b= false;
            }
        }
        
        return b;
    }
    //Method: Prime Number from interger list
    public static void primeCountList(List<Integer> nList){
        List<Integer> pList = new ArrayList<>();
        List<Integer> npList = new ArrayList<>();
        
        for(int n : nList){
            if(primeCheck(n)){
                pList.add(n);
            }
            else{
                npList.add(n);
            }
        }
        
        System.out.println("List of Prime Number: "+pList);
        System.out.println("List of NON Prime Number: "+npList);
    }
    //Method: Sort Integer List
    public static List<Integer> sortNumber(List<Integer> sList){
        
        int n = sList.size();

         for (int i = 0; i < n - 1; i++) {
            for (int j = 0; j < n - i - 1; j++) {
                // Compare adjacent elements
                if (sList.get(j) > sList.get(j + 1)) {
                    // Swap elements if they are in the wrong order
                    int temp = sList.get(j);
                    sList.set(j, sList.get(j + 1));
                    sList.set(j + 1, temp);
                }
            }
         }    
        return sList;
    }
    
    //Method: for verify the the is Armstrong?:
    public static void armstrongNumber(int n){
        int a, c=0, temp;
        
        temp = n;
        
        while(n>0){
            
            a = n%10;
            n = n/10;
            
            c = c+ (a*a*a);
        }
        
        if(temp == c){
            System.out.println(temp + " is a Armstrong Number.");
        }
        else{
            System.out.println(temp + " is NOT a Armstrong Number.");
        }
    }
    
